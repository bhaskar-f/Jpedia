EMAIL_SECURE=false
EMAIL_USER=
# For Gmail, use a Google App Password here, not the account password.
EMAIL_PASSWORD=
EMAIL_FROM=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_MOBILE=
