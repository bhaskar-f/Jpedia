    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^2.0.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.11",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
