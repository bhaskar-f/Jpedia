NODE_ENV=production
CLIENT_ORIGINS=https://YOUR-FRONTEND-VERCEL-DOMAIN
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER/jpedia?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=https://YOUR-BACKEND-VERCEL-DOMAIN/api/auth/google/callback
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=YOUR_GMAIL_ADDRESS
EMAIL_PASSWORD=YOUR_GOOGLE_APP_PASSWORD
EMAIL_FROM="SetBGet <YOUR_GMAIL_ADDRESS>"
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET
CRON_SECRET=replace-with-a-random-cron-secret-of-at-least-16-characters
